# =============================================================
# AI Crop Disease Detection — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-this

# Database connection (SQLite default; replace with MySQL URL for production)
# SQLite:  sqlite:///cropcare.db
# MySQL:   mysql+pymysql://user:password@localhost/cropcare_db
DATABASE_URL=sqlite:///cropcare.db

# Model paths
MODEL_PATH=models/crop_disease_model.keras
CLASS_NAMES_PATH=models/class_names.json

# Upload settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=5242880

# Confidence thresholds (0.0 - 1.0)
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.50

# Default language: en | ta
DEFAULT_LANGUAGE=en

# Weather API (optional — get free key from openweathermap.org)
WEATHER_API_KEY=your-openweathermap-api-key-here

# Admin credentials (first-run bootstrap)
ADMIN_EMAIL=admin@cropcare.ai
ADMIN_PASSWORD=changeme123

# Debug mode (set to False in production)
FLASK_DEBUG=True
FLASK_ENV=development
